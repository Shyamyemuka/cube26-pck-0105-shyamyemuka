# .env.example — copy to .env.local (never commit real values)

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY. Used by scripts/seed.ts, eval, evidence-API token check.

# Vision model
VLM_PROVIDER=gemini
VLM_MODEL=gemini-3.5-flash          # fallback: gemini-2.5-flash
VLM_TIMEOUT_MS=20000
GEMINI_API_KEY=
PROMPT_VERSION=pack-audit.v1

# Thresholds (defaults live in lib/agent/config.ts; override only for dev sweeps)
T_PRESENT=0.70
T_COUNT=0.75
T_EXTRA=0.70
T_EXTRA_UNSURE=0.35

# Cross-pod evidence API: token:org_id pairs, comma-separated
EVIDENCE_API_TOKENS=

# Seeding demo users (local only)
SEED_PASSWORD=
